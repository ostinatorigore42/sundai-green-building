# Copy to .env for local runs. On Replit these go in the Secrets panel instead —
# never commit the real .env, it is gitignored for a reason.

# ── Models ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=            # Whisper transcription + the LLM reply
CARTESIA_API_KEY=        # TTS (TTS_PROVIDER=cartesia)
OPENAI_API_KEY=          # used by openai.ts alongside the Groq path
ELEVENLABS_API_KEY=      # alternative TTS, not the default

# ── Storage ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

# ── Server ───────────────────────────────────────────────────────────────────
# Replit sets PORT itself. Locally, HTTP_PORT is the fallback and everything —
# the /talk page, /device and /monitor — shares that one port.
HTTP_PORT=8000

# Gate on both WebSockets: connect with ?k=<SHARED_KEY>. Leave it EMPTY and the
# check is skipped, which is what you want for a LAN run or an ESP32 you would
# rather not reflash. Set it before exposing the host publicly, or anyone with
# the URL can spend your model credits and read every transcript on /monitor.
SHARED_KEY=

# ── Tower ────────────────────────────────────────────────────────────────────
# The Green Building simulator instance. Set it and server.ts spawns
# tower/bridge.py as a child process, so the display runs for as long as the
# service does. Leave it EMPTY when someone else is driving that instance —
# two bridges aimed at one instance make the building flicker between them.
BRIDGE_INSTANCE=

# Override if python3 is not on PATH under that name.
# PYTHON_BIN=python3

# ── Pipeline ─────────────────────────────────────────────────────────────────
USE_VAD=true             # false = 5-second timer instead of Silero
TEST_MODE=false          # true = transcription only, no LLM reply
TTS_PROVIDER=cartesia
